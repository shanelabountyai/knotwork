// Knotwork (clone-owned, PRD v1.1 Phase 1): the wedding, its backward-scheduled tasks, the budget and vendor book, and
// the two-key consent requests. Every table is org-owned: RLS policies in 20261123000002_rls_policies_knotwork (INV-30),
// all thirteen in the data export (src/app/export-hooks.ts, INV-34), harness rows in tests/fixtures/app.ts.
//
// RULE 1 (CLAUDE.md): the only stored deadline is Wedding.date. A task stores leadDays, bufferDays and dependencies;
// its dates are derived on read (src/lib/knotwork/schedule/engine.ts). tests/knotwork/structure.test.ts scans this
// file: a new date column fails until it is named there as a date of fact.
// RULE 2: the fields marked "designated" are written only by src/lib/knotwork/consent/execute.ts, and the database
// refuses them without an approved request (triggers in 20261123000001_knotwork_phase1).

enum TaskKind {
  template
  manual
  payment
  rsvp
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum VendorStatus {
  considering
  booked
  dropped
}

enum VendorCategory {
  venue
  caterer
  photographer
  dj
  florist
  officiant
  baker
  attire
  transport
  planner
  other
}

enum FlagReason {
  date_moved
  scope_changed
}

enum ConsentKind {
  book_vendor
  sign_contract
  spend
  change_date
  change_settings
  remove_guest
  set_mode
}

enum ConsentStatus {
  pending
  approved
  declined
  withdrawn
  expired
}

enum GrantScope {
  schedule_edit
  budget_view
  budget_edit
  vendors_view
  vendors_edit
  guests_edit
  photos_moderate
  funder
}

enum BaselineKind {
  initial
  move
}

/// One per org (D-07). `date` is the anchor every deadline derives from.
model Wedding {
  id                  String          @id @default(uuid()) @db.Uuid
  orgId               String          @unique @db.Uuid
  org                 Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title               String
  /// Designated after creation: changes only with an approved change_date request (dateRequestId).
  date                DateTime        @db.Date
  dateRequestId       String?         @db.Uuid
  dateRequest         ConsentRequest? @relation("weddingDate", fields: [dateRequestId], references: [id], onDelete: NoAction)
  timeZone            String          @default("America/Chicago")
  /// Designated: these three change only with an approved change_settings request (settingsRequestId).
  spendThresholdCents Int             @default(50000)
  consentExpiryDays   Int             @default(7)
  chaseBufferDays     Int             @default(14)
  settingsRequestId   String?         @db.Uuid
  settingsRequest     ConsentRequest? @relation("weddingSettings", fields: [settingsRequestId], references: [id], onDelete: NoAction)
  /// A date of fact (D-33): the first moment the workspace was seen with two partners. Never unset; while it is null
  /// and there is one partner, that partner's designated actions execute solo.
  pairedAt            DateTime?       @db.Timestamptz(6)
  /// Phase 5, designated: planning, or the couple's life-admin mode after the wedding day. Changes only with an
  /// approved set_mode request (modeRequestId), whose payload names this mode.
  mode                WeddingMode     @default(planning)
  modeRequestId       String?         @db.Uuid
  modeRequest         ConsentRequest? @relation("weddingMode", fields: [modeRequestId], references: [id], onDelete: NoAction)
  /// A date of fact: when the mode last changed (null while it never has). Never a deadline.
  modeChangedAt       DateTime?       @db.Timestamptz(6)
  createdById         String?         @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)
}

/// No date of its own: due = wedding - bufferDays (or earlier, if something depends on it); startBy = due - leadDays.
model Task {
  id          String           @id @default(uuid()) @db.Uuid
  orgId       String           @db.Uuid
  org         Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The template key, or 'rsvp-deadline' for the derived RSVP task. Null for manual and payment tasks.
  key         String?
  title       String
  kind        TaskKind         @default(manual)
  leadDays    Int
  bufferDays  Int
  status      TaskStatus       @default(todo)
  assigneeId  String?          @db.Uuid
  assignee    User?            @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// A date of fact: the day it was marked done.
  completedOn DateTime?        @db.Date
  vendorId    String?          @db.Uuid
  vendor      Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  notes       String           @default("")
  /// P1-1 (ADR-001): private to this partner until the reveal point; null means shared. Never a deadline (rule 1).
  privateToId String? @db.Uuid
  /// The reveal point: days after the wedding date (negative: before; 0: the wedding day). Null while private: only by hand.
  revealDays  Int?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  dependsOn   TaskDependency[] @relation("dependencyTask")
  dependents  TaskDependency[] @relation("dependencyOn")
  payment     VendorPayment?

  @@unique([orgId, key])
  @@index([orgId])
}

model TaskDependency {
  id          String @id @default(uuid()) @db.Uuid
  orgId       String @db.Uuid
  org         Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  taskId      String @db.Uuid
  task        Task   @relation("dependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String @db.Uuid
  dependsOn   Task   @relation("dependencyOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([orgId])
  @@index([dependsOnId])
}

/// One row per committed wedding date: the first one, and every approved move. History, not a deadline.
model ScheduleBaseline {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @db.Uuid
  org         Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind        BaselineKind
  fromDate    DateTime?       @db.Date
  toDate      DateTime        @db.Date
  requestId   String?         @db.Uuid
  request     ConsentRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction)
  /// { tasks: { id: { title, dueFrom, dueTo, startByFrom, startByTo, state } }, late, impossible }
  snapshot    Json
  /// 16 hex characters of the preview that was committed.
  fingerprint String
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)

  @@index([orgId, createdAt])
}

model BudgetCategory {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @db.Uuid
  org           Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  estimateCents Int
  /// P1-1 (ADR-001): private to this partner until the reveal point; null means shared. Never a deadline (rule 1).
  privateToId String? @db.Uuid
  /// The reveal point: days after the wedding date (negative: before; 0: the wedding day). Null while private: only by hand.
  revealDays  Int?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  expenses      Expense[]
  pledges       FunderPledge[]

  @@unique([orgId, name])
}

/// An actual. Strictly over the spend threshold it is designated: it needs an approved spend request (requestId).
model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @db.Uuid
  org         Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  categoryId  String          @db.Uuid
  category    BudgetCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendorId    String?         @db.Uuid
  vendor      Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  description String
  amountCents Int
  /// A date of fact: the day the money went out.
  paidOn      DateTime        @db.Date
  requestId   String?         @db.Uuid
  request     ConsentRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction)
  createdById String?         @db.Uuid
  /// P1-1 (ADR-001): private to this partner until the reveal point; null means shared. Never a deadline (rule 1).
  privateToId String? @db.Uuid
  /// The reveal point: days after the wedding date (negative: before; 0: the wedding day). Null while private: only by hand.
  revealDays  Int?
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  payment     VendorPayment?
  allocations FunderAllocation[]

  @@index([orgId])
  @@index([categoryId])
}

/// PRD P0-7 "snapshots": the rollup frozen at a moment.
model BudgetSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  note      String   @default("")
  totals    Json
  takenById String?  @db.Uuid
  takenAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([orgId, takenAt])
}

model Vendor {
  id                 String          @id @default(uuid()) @db.Uuid
  orgId              String          @db.Uuid
  org                Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name               String
  category           VendorCategory
  contactName        String          @default("")
  email              String          @default("")
  phone              String          @default("")
  notes              String          @default("")
  /// Designated: `booked` only with an approved book_vendor request (bookedRequestId).
  status             VendorStatus    @default(considering)
  bookedRequestId    String?         @db.Uuid
  bookedRequest      ConsentRequest? @relation("vendorBooked", fields: [bookedRequestId], references: [id], onDelete: NoAction)
  contractTotalCents Int?
  /// Designated: set only with an approved sign_contract request (contractRequestId). A date of fact.
  contractSignedOn   DateTime?       @db.Date
  contractRequestId  String?         @db.Uuid
  contractRequest    ConsentRequest? @relation("vendorContract", fields: [contractRequestId], references: [id], onDelete: NoAction)
  /// Scope (D-16): a change to any of these four on a booked vendor raises a re-confirmation flag.
  deliverables       String          @default("")
  /// Minutes after midnight on the wedding day.
  arriveMin          Int?
  departMin          Int?
  countEstimate      Int?
  /// The vendor needs the final count this many days before the wedding; drives the RSVP deadline.
  countDueDaysBefore Int?
  /// Eats on site (a vendor meal in Phase 2's counts).
  onSite             Boolean         @default(false)
  /// P1-1 (ADR-001): private to this partner until the reveal point; null means shared. Never a deadline (rule 1).
  privateToId String? @db.Uuid
  /// The reveal point: days after the wedding date (negative: before; 0: the wedding day). Null while private: only by hand.
  revealDays  Int?
  /// D-42: the vendor's read-only link (/v/[token]): sha256 of the token, and a sealed copy so the couple can show it
  /// again. Null: no link. Replacing it stops the old one at once. Never exported.
  linkTokenHash      String?         @unique
  linkTokenSealed    String?
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  tasks              Task[]
  payments           VendorPayment[]
  flags              VendorFlag[]
  briefs             VendorBrief[]
  expenses           Expense[]
  attachments        VendorAttachment[]
  contingencyItems   ContingencyItem[]

  @@index([orgId])
}

/// A scheduled payment: "N days before the wedding". Its task carries it on the schedule (P0-1).
model VendorPayment {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @db.Uuid
  org           Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendorId      String    @db.Uuid
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  label         String
  amountCents   Int
  dueDaysBefore Int
  taskId        String    @unique @db.Uuid
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// A date of fact.
  paidOn        DateTime? @db.Date
  expenseId     String?   @unique @db.Uuid
  expense       Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([orgId])
  @@index([vendorId])
}

/// "Needs re-confirmation" while ackAt is null.
model VendorFlag {
  id         String     @id @default(uuid()) @db.Uuid
  orgId      String     @db.Uuid
  org        Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendorId   String     @db.Uuid
  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reason     FlagReason
  detail     Json
  raisedById String?    @db.Uuid
  raisedAt   DateTime   @default(now()) @db.Timestamptz(6)
  ackById    String?    @db.Uuid
  ackAt      DateTime?  @db.Timestamptz(6)
  ackNote    String     @default("")

  @@index([orgId, ackAt])
  @@index([vendorId])
}

/// A regenerable artifact: a new version only when the inputs changed.
model VendorBrief {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendorId      String   @db.Uuid
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  version       Int
  body          String
  inputsHash    String
  generatedById String?  @db.Uuid
  generatedAt   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([vendorId, version])
  @@index([orgId])
}

/// The two-key request (src/lib/knotwork/consent/machine.ts). `approved` is written together with the action it allows.
model ConsentRequest {
  id              String             @id @default(uuid()) @db.Uuid
  orgId           String             @db.Uuid
  org             Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind            ConsentKind
  status          ConsentStatus      @default(pending)
  payload         Json
  summary         String
  proposerId      String             @db.Uuid
  proposedAt      DateTime           @default(now()) @db.Timestamptz(6)
  /// When the request lapses: proposedAt plus the wedding's consentExpiryDays. Not a plan deadline.
  expiresAt       DateTime           @db.Timestamptz(6)
  deciderId       String?            @db.Uuid
  decidedAt       DateTime?          @db.Timestamptz(6)
  declineReason   String             @default("")
  executedAt      DateTime?          @db.Timestamptz(6)
  /// D-33: executed by the only partner of a never-paired workspace; then deciderId is null.
  solo            Boolean            @default(false)
  weddingDates    Wedding[]          @relation("weddingDate")
  weddingSettings Wedding[]          @relation("weddingSettings")
  weddingModes    Wedding[]          @relation("weddingMode")
  bookedVendors   Vendor[]           @relation("vendorBooked")
  signedVendors   Vendor[]           @relation("vendorContract")
  expenses        Expense[]
  baselines       ScheduleBaseline[]
  removedGuests   Guest[]

  @@index([orgId, status])
}

/// A scoped grant for a helper (D-08). Partners need none.
model HelperGrant {
  id          String     @id @default(uuid()) @db.Uuid
  orgId       String     @db.Uuid
  org         Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       GrantScope
  grantedById String?    @db.Uuid
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)

  @@unique([orgId, userId, scope])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 2 (PRD P0-3 guest engine, P0-4 tiered backfill). RULE 3: nothing in Household.list, priority, state, invitedOn,
// waveId or createdAt may reach a guest; src/lib/knotwork/guests/projection.ts is the only guest-facing shape.

enum GuestList {
  A
  B
}

enum HouseholdState {
  queued
  invited
  regrets
}

enum AgeGroup {
  adult
  child
  infant
}

enum PartnerStatus {
  none
  dating
  long_distance
  engaged
  married
}

enum RsvpStatus {
  pending
  attending
  declined
}

enum PlusOneOverride {
  grant
  deny
}

enum ChaseKind {
  reminder
  call
}

/// One per org: the cap the invite waves run against, the venue's limits and the per-head prices.
model GuestPlan {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @unique @db.Uuid
  org             Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cap             Int      @default(100)
  venueMin        Int?
  venueMax        Int?
  perHeadCents    Int      @default(0)
  kidsMealCents   Int      @default(0)
  vendorMealCents Int      @default(0)
  /// No B wave inside this many days of the wedding; remaining B households become regrets.
  lockoutDays     Int      @default(42)
  /// A B wave releases at least this many seats, unless it is everything left.
  minBatchSeats   Int      @default(4)
  mealOptions     String[]
  /// P1-5: whether the seating chart also seats guests who have not answered yet (attending guests always are).
  seatPending     Boolean  @default(false)
  /// Phase 5: due reminders also go out on the daily schedule (cron), not only from the button. Off by default.
  autoReminders   Boolean  @default(false)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
}

/// Phase 5: how a household's reminders are delivered.
enum ReminderChannel {
  email
  sms
  none
}

/// The invitation unit.
model Household {
  id                String           @id @default(uuid()) @db.Uuid
  orgId             String           @db.Uuid
  org               Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name              String
  email             String           @default("")
  phone             String           @default("")
  address1          String           @default("")
  city              String           @default("")
  region            String           @default("")
  postal            String           @default("")
  list              GuestList        @default(A)
  priority          Int              @default(100)
  state             HouseholdState   @default(queued)
  /// A date of fact: the day the invitation was released. Never shown to a guest.
  invitedOn         DateTime?        @db.Date
  waveId            String?          @db.Uuid
  wave              InviteWave?      @relation(fields: [waveId], references: [id], onDelete: SetNull)
  /// A date of fact, recorded by hand.
  saveTheDateSentOn DateTime?        @db.Date
  plusOneOverride   PlusOneOverride?
  plusOneNote       String           @default("")
  /// sha256 of the RSVP link token (INV-07), and a sealed copy so a reminder can carry the same link. Never exported.
  rsvpTokenHash     String?          @unique
  rsvpTokenSealed   String?
  /// Phase 5: how reminders reach this household. sms only with a phone and an SMS consent date (the database checks).
  remindVia         ReminderChannel  @default(email)
  /// A date of fact: the day the household agreed to reminders by text message.
  smsConsentOn      DateTime?        @db.Date
  /// A date of fact: when the household stopped reminders from its own link. No reminder goes after it.
  remindersStoppedAt DateTime?       @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  guests            Guest[]
  chaseEvents       ChaseEvent[]
  giftEntries       GiftEntry[]
  thankYous         ThankYou[]
  giftLogs          GiftLog[]
  registryClaims    RegistryClaim[]

  @@unique([orgId, name])
}

/// The response unit. Never deleted: removed only by an approved remove_guest request (rule 2).
model Guest {
  id               String          @id @default(uuid()) @db.Uuid
  orgId            String          @db.Uuid
  org              Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  householdId      String          @db.Uuid
  household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name             String
  ageGroup         AgeGroup        @default(adult)
  partnerStatus    PartnerStatus   @default(none)
  inWeddingParty   Boolean         @default(false)
  isPlusOne        Boolean         @default(false)
  rsvp             RsvpStatus      @default(pending)
  meal             String?
  dietary          String[]
  accessibility    String[]
  songRequest      String          @default("")
  /// The couple's own note. Never guest-facing, never vendor-facing.
  privateNote      String          @default("")
  respondedAt      DateTime?       @db.Timestamptz(6)
  /// Designated: set only with an approved remove_guest request (removedRequestId). A date of fact.
  removedAt        DateTime?       @db.Timestamptz(6)
  removedRequestId String?         @db.Uuid
  removedRequest   ConsentRequest? @relation(fields: [removedRequestId], references: [id], onDelete: NoAction)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  seat             Seat?
  seatingRulesA    SeatingRule[]   @relation("seatingRuleA")
  seatingRulesB    SeatingRule[]   @relation("seatingRuleB")

  @@index([orgId])
  @@index([householdId])
}

/// One row per release of invitations.
model InviteWave {
  id             String      @id @default(uuid()) @db.Uuid
  orgId          String      @db.Uuid
  org            Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number         Int
  list           GuestList
  releasedAt     DateTime    @default(now()) @db.Timestamptz(6)
  releasedById   String?     @db.Uuid
  householdCount Int
  seatCount      Int
  households     Household[]

  @@unique([orgId, number])
}

/// The delta feed: "Linda declined: −$87.00".
model HeadcountDelta {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label          String
  deltaSeats     Int
  deltaCents     Int
  attendingAfter Int
  costAfterCents Int
  at             DateTime @default(now()) @db.Timestamptz(6)

  @@index([orgId, at])
}

/// A reminder sent or a personal call made, so the cadence never repeats a step.
model ChaseEvent {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  kind        ChaseKind
  step        Int
  byId        String?   @db.Uuid
  at          DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([householdId, kind, step])
  @@index([orgId])
}

/// The couple's do-not-play list; rides onto the DJ's brief.
model DoNotPlay {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title     String
  artist    String   @default("")
  addedById String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([orgId, title, artist])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 3: group gifting (PRD P0-5). Mock money, ledgered in integer cents; nothing is charged.
// PRIVACY: GiftEntry.amountCents is what one household gave. The couple's side reads sums per item and contributor
// names only (src/lib/knotwork/gifts/couple.ts); tests/knotwork/structure.test.ts scans for it.

enum RegistryItemState {
  open
  funded
  closed_unfunded
}

enum GiftEntryKind {
  contribution
  excess_return
  refund
}

/// A pooled registry item: several households give toward one target.
model RegistryItem {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @db.Uuid
  org         Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String
  note        String            @default("")
  targetCents Int
  state       RegistryItemState @default(open)
  /// A date of fact: the day the pot reached its target.
  fundedOn    DateTime?         @db.Date
  /// A date of fact: the day the registry was closed with this item unfunded (everything given was refunded).
  closedOn    DateTime?         @db.Date
  createdById String?           @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  entries     GiftEntry[]
  thankYous   ThankYou[]

  @@unique([orgId, title])
}

/// The gift ledger. Append-only: a trigger refuses every UPDATE and DELETE. A contribution is positive; an excess
/// return and a refund are negative. The pot is the sum.
model GiftEntry {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String        @db.Uuid
  org         Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  itemId      String        @db.Uuid
  item        RegistryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  householdId String        @db.Uuid
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  kind        GiftEntryKind
  amountCents Int
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)

  @@index([orgId])
  @@index([itemId])
  @@index([householdId])
}

/// A thank-you the couple owes: one per household that gave toward an item that funded (P1-3 adds aging on top).
model ThankYou {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @db.Uuid
  org              Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  itemId           String       @db.Uuid
  item             RegistryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  householdId      String       @db.Uuid
  household        Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  /// A date of fact: the day a partner marked the thank-you as sent.
  acknowledgedOn   DateTime?    @db.Date
  acknowledgedById String?      @db.Uuid

  @@unique([itemId, householdId])
  @@index([orgId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 3 (PRD P0-6 photo wall; contract attachments, D-39). RULE 4: every byte in PhotoBlob.bytes and
// VendorAttachment.bytes was written by src/lib/knotwork/uploads/ (decoded, re-encoded, inspected clean); the raw
// upload is never stored. RULE 1: when an upload link stops and when photos are purged are DERIVED from Wedding.date
// (uploadDays, retentionDays); no column holds either day. RULE 3: /p/[token] shows the wedding title and the event
// name, nothing else.

enum PhotoMode {
  pre
  post
}

enum PhotoStatus {
  pending
  live
  removed
}

enum PhotoBlobKind {
  full
  display
  thumb
}

/// Phase 5 (D-135): which classifier advises the moderator on an event. none: no advice (today's behaviour).
enum PhotoClassifier {
  none
  stub
}

/// A classifier's advice. ok: nothing to look at. review: shown flagged in the console. hold: under post-moderation,
/// the photo starts in the waiting queue instead of on the wall. Advice never approves, removes or publishes.
enum PhotoSuggestion {
  ok
  review
  hold
}

/// One wall: an upload link (its sha256, and a sealed copy for the QR code), and how it is moderated.
model PhotoEvent {
  id                String        @id @default(uuid()) @db.Uuid
  orgId             String        @db.Uuid
  org               Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name              String
  /// post: a photo is live at once and removed on sight. pre: a photo waits until someone approves it.
  mode              PhotoMode     @default(post)
  uploadTokenHash   String        @unique
  uploadTokenSealed String
  uploadsOpen       Boolean       @default(true)
  /// The link stops this many days after the wedding date (derived on read; D-68).
  uploadDays        Int           @default(7)
  /// Photos are purged this many days after the wedding date (derived on read).
  retentionDays     Int           @default(365)
  /// Phase 5 (D-135): off (none) by default.
  classifier        PhotoClassifier @default(none)
  createdById       String?       @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  photos            Photo[]
  devices           PhotoDevice[]

  @@unique([orgId, name])
}

/// A device is a random cookie on the upload page; only its sha256 is kept. Blocking one refuses its uploads.
model PhotoDevice {
  id          String     @id @default(uuid()) @db.Uuid
  orgId       String     @db.Uuid
  org         Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId     String     @db.Uuid
  event       PhotoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokenHash   String
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  /// A date of fact: when a moderator blocked the device.
  blockedAt   DateTime?  @db.Timestamptz(6)
  blockedById String?    @db.Uuid
  photos      Photo[]

  @@unique([eventId, tokenHash])
  @@index([orgId])
}

/// A photo's facts. Its bytes are in PhotoBlob, so a list never loads them.
model Photo {
  id              String       @id @default(uuid()) @db.Uuid
  orgId           String       @db.Uuid
  org             Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId         String       @db.Uuid
  event           PhotoEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deviceId        String       @db.Uuid
  device          PhotoDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  uploaderName    String       @default("")
  caption         String       @default("")
  status          PhotoStatus
  /// What the photo was before it was removed (pending: rejected; live: taken down), so undo can put it back.
  removedFrom     PhotoStatus?
  hiddenFromWall  Boolean      @default(false)
  hiddenFromAlbum Boolean      @default(false)
  mime            String
  width           Int
  height          Int
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  /// A date of fact: when the retention purge deleted this photo's bytes.
  purgedAt        DateTime?    @db.Timestamptz(6)
  /// Phase 5 (D-135): the classifier's advice at ingest (null: none ran), why, and its labels with scores.
  suggestion       PhotoSuggestion?
  suggestionReason String       @default("")
  suggestionLabels Json?
  blobs           PhotoBlob[]

  @@index([orgId])
  @@index([eventId, createdAt])
  @@index([deviceId])
}

/// The re-encoded renditions (D-64: bytea for now, behind photos/blobs.ts). Never in the data export.
model PhotoBlob {
  id      String        @id @default(uuid()) @db.Uuid
  orgId   String        @db.Uuid
  org     Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  photoId String        @db.Uuid
  photo   Photo         @relation(fields: [photoId], references: [id], onDelete: Cascade)
  kind    PhotoBlobKind
  bytes   Bytes
  size    Int
  width   Int
  height  Int

  @@unique([photoId, kind])
  @@index([orgId])
}

/// A photographed or scanned contract page on a vendor (images only, D-65), through the same pipeline.
model VendorAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendorId     String   @db.Uuid
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  label        String
  mime         String
  size         Int
  width        Int
  height       Int
  bytes        Bytes
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([orgId])
  @@index([vendorId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 4, P1-2: the multi-funder family budget. A funder is a named source (a parent, a relative), not a member; a
// member may be linked to one with the `funder` helper grant and then sees only what that funder gave toward.
// Integer cents. Pledged >= received >= spent, per pledge; the database checks the sums at commit.

/// A named source of money. `userId` links a helper (with the `funder` grant) who sees this funder's part only.
model Funder {
  id          String         @id @default(uuid()) @db.Uuid
  orgId       String         @db.Uuid
  org         Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  note        String         @default("")
  userId      String?        @db.Uuid
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  pledges     FunderPledge[]

  @@unique([orgId, name])
  @@unique([orgId, userId])
}

/// What one funder promised toward one budget category.
model FunderPledge {
  id          String             @id @default(uuid()) @db.Uuid
  orgId       String             @db.Uuid
  org         Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  funderId    String             @db.Uuid
  funder      Funder             @relation(fields: [funderId], references: [id], onDelete: Cascade)
  categoryId  String             @db.Uuid
  category    BudgetCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amountCents Int
  createdById String?            @db.Uuid
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  receipts    FunderReceipt[]
  allocations FunderAllocation[]

  @@unique([funderId, categoryId])
  @@index([orgId])
  @@index([categoryId])
}

/// Money that arrived against a pledge (may be partial).
model FunderReceipt {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @db.Uuid
  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pledgeId    String       @db.Uuid
  pledge      FunderPledge @relation(fields: [pledgeId], references: [id], onDelete: Cascade)
  amountCents Int
  /// A date of fact: the day the money arrived.
  receivedOn  DateTime     @db.Date
  note        String       @default("")
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)

  @@index([orgId])
  @@index([pledgeId])
}

/// Received money spent: part of an expense in the pledge's category paid from this pledge.
model FunderAllocation {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @db.Uuid
  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pledgeId    String       @db.Uuid
  pledge      FunderPledge @relation(fields: [pledgeId], references: [id], onDelete: Cascade)
  expenseId   String       @db.Uuid
  expense     Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amountCents Int
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([pledgeId, expenseId])
  @@index([orgId])
  @@index([expenseId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 4, P1-3 and P1-8: the thank-you ledger and link-out registry items. RULE 1: every date here is a date of fact
// (a gift arrived, a household said it bought something, a partner sent the note); how long a thank-you has been owed
// is computed on read (src/lib/knotwork/thanks/aging.ts) and never stored.

/// P1-3: a gift the couple records by hand (the gift log): from a household or from a named person, never both.
model GiftLog {
  id               String     @id @default(uuid()) @db.Uuid
  orgId            String     @db.Uuid
  org              Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  householdId      String?    @db.Uuid
  household        Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  giverName        String     @default("")
  what             String
  /// A date of fact: the day the gift arrived. The thank-you ages from here.
  receivedOn       DateTime   @db.Date
  /// A date of fact: the day a partner marked the thank-you as sent.
  acknowledgedOn   DateTime?  @db.Date
  acknowledgedById String?    @db.Uuid
  createdById      String?    @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)

  @@index([orgId])
  @@index([householdId])
}

/// P1-8: a registry item bought from a store. The URL is https only and checked (registry/links.ts); nothing is ever
/// fetched from it. Guests mark "I bought this" through their household link.
model RegistryLink {
  id             String          @id @default(uuid()) @db.Uuid
  orgId          String          @db.Uuid
  org            Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title          String
  store          String
  url            String
  priceCents     Int?
  quantityWanted Int
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  claims         RegistryClaim[]

  @@unique([orgId, title])
}

/// One household's "I bought this" against a link-out item. It is also a gift on the thank-you ledger (P1-3).
model RegistryClaim {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @db.Uuid
  org              Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  linkId           String       @db.Uuid
  link             RegistryLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  householdId      String       @db.Uuid
  household        Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  quantity         Int
  /// A date of fact: the day the household said it bought the item. The thank-you ages from here.
  claimedOn        DateTime     @db.Date
  /// A date of fact: the day a partner marked the thank-you as sent.
  acknowledgedOn   DateTime?    @db.Date
  acknowledgedById String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([linkId, householdId])
  @@index([orgId])
  @@index([householdId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 4, P1-4: the name-change sequence. The workflow itself is data (rules/name-change/*.json, illustrative only);
// these tables hold one partner's progress through it. RULE 1: a step stores no date but the day it was finished (a
// date of fact); "start after the wedding" is an offset in the rules, worked out from Wedding.date on read. Private
// to its partner unless shared (D-114): the change log is masked at write like a sealed item (secrecy/seal.ts).

enum NameStepStatus {
  started
  done
}

/// One partner's name change: which jurisdiction's rules it follows, and whether the other partner may see it.
model NameChange {
  id           String               @id @default(uuid()) @db.Uuid
  orgId        String               @db.Uuid
  org          Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The partner whose name change this is. Only they change it.
  userId       String               @db.Uuid
  /// A rules file's key (rules/name-change/<key>.json); 'generic' is the fallback.
  jurisdiction String
  /// False: private to its partner (the default). True: the other partner may read it (never change it).
  shared       Boolean              @default(false)
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  steps        NameChangeStep[]
  artifacts    NameChangeArtifact[]

  @@unique([orgId, userId])
}

/// A step that has been started or finished. A step with no row has not been started.
model NameChangeStep {
  id           String         @id @default(uuid()) @db.Uuid
  orgId        String         @db.Uuid
  org          Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nameChangeId String         @db.Uuid
  nameChange   NameChange     @relation(fields: [nameChangeId], references: [id], onDelete: Cascade)
  /// The step's key in the rules file.
  step         String
  status       NameStepStatus
  /// A date of fact: the day it was marked done.
  completedOn  DateTime?      @db.Date

  @@unique([nameChangeId, step])
  @@index([orgId])
}

/// A document the partner holds (a certified marriage certificate, a new Social Security card).
model NameChangeArtifact {
  id           String     @id @default(uuid()) @db.Uuid
  orgId        String     @db.Uuid
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nameChangeId String     @db.Uuid
  nameChange   NameChange @relation(fields: [nameChangeId], references: [id], onDelete: Cascade)
  /// The artifact's key in the rules file.
  artifact     String
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  @@unique([nameChangeId, artifact])
  @@index([orgId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 4, P1-6: contingency decision trees (a rain plan, a vendor no-show). A plan is a small tree of questions whose
// leaves are actions; executing one branch writes a run, its checklist, the tasks it adds (ordinary tasks with
// leadDays and bufferDays, so their dates derive from the wedding date, rule 1) and the spends it records or PROPOSES
// (rule 2: a spend over the threshold only ever becomes a consent request). One run per plan (D-121).

enum ContingencyItemKind {
  check
  notify
}

/// A decision tree (validated by src/lib/knotwork/contingency/tree.ts before it is stored).
model ContingencyPlan {
  id          String           @id @default(uuid()) @db.Uuid
  orgId       String           @db.Uuid
  org         Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String
  tree        Json
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  run         ContingencyRun?

  @@unique([orgId, title])
}

/// The one time a plan was put into action: which answers were given, and the fingerprint of the preview executed.
model ContingencyRun {
  id           String            @id @default(uuid()) @db.Uuid
  orgId        String            @db.Uuid
  org          Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId       String            @unique @db.Uuid
  plan         ContingencyPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// The branch taken at each question, from the root (indexes), and the leaf it reached.
  path         Json
  leaf         String
  /// 16 hex characters of the preview that was executed.
  fingerprint  String
  /// What executing did: the tasks added, the spends recorded and the requests proposed (ids).
  result       Json
  executedById String?           @db.Uuid
  /// A date of fact: when the branch was executed.
  executedAt   DateTime          @default(now()) @db.Timestamptz(6)
  items        ContingencyItem[]

  @@index([orgId])
}

/// One line of an executed branch's checklist: a thing to do, or a vendor to tell.
model ContingencyItem {
  id       String              @id @default(uuid()) @db.Uuid
  orgId    String              @db.Uuid
  org      Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runId    String              @db.Uuid
  run      ContingencyRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  position Int
  kind     ContingencyItemKind
  text     String
  vendorId String?             @db.Uuid
  vendor   Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// A date of fact: the day it was ticked off.
  doneOn   DateTime?           @db.Date
  doneById String?             @db.Uuid

  @@unique([runId, position])
  @@index([orgId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 4, P1-5: the seating chart. A guest-list feature (guests.view / guests.edit); never on a guest-facing surface
// (rule 3). Tables and pair rules are the couple's input; seats are what generate (src/lib/knotwork/seating/engine.ts),
// a manual move or a lock wrote. Nothing here is a date (rule 1).

enum SeatingRuleKind {
  apart
  together
}

/// A table at the reception, with how many it seats.
model SeatingTable {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  seats     Seat[]

  @@unique([orgId, name])
}

/// Two guests who must sit apart, or together. `hard`: a seating that breaks it is not acceptable; otherwise a
/// preference the score weighs. Stored with the smaller guest id first (the database checks it), so a pair is one row.
model SeatingRule {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @db.Uuid
  org         Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind        SeatingRuleKind
  hard        Boolean
  guestAId    String          @db.Uuid
  guestA      Guest           @relation("seatingRuleA", fields: [guestAId], references: [id], onDelete: Cascade)
  guestBId    String          @db.Uuid
  guestB      Guest           @relation("seatingRuleB", fields: [guestBId], references: [id], onDelete: Cascade)
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)

  @@unique([guestAId, guestBId])
  @@index([orgId])
}

/// Where one guest sits. `locked`: a regenerate keeps it.
model Seat {
  id      String       @id @default(uuid()) @db.Uuid
  orgId   String       @db.Uuid
  org     Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  guestId String       @unique @db.Uuid
  guest   Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tableId String       @db.Uuid
  table   SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  locked  Boolean      @default(false)

  @@index([orgId])
  @@index([tableId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 5, slice F: the couple's life-admin mode after the wedding (D-143 onward).

enum WeddingMode {
  planning
  life
}

/// How a household task comes round again: every N days, weeks or months after it was last done, or yearly on the
/// wedding anniversary (derived from Wedding.date).
enum RecurUnit {
  day
  week
  month
  anniversary
}

/// A recurring household task. RULE 1: it stores a RULE (unit and every), never a date; when it is next due is
/// worked out on read from its done-on log, or from Wedding.date for the anniversary (lifeadmin/recurrence.ts).
model RecurringTask {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @db.Uuid
  org         Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String
  unit        RecurUnit
  every       Int             @default(1)
  notes       String          @default("")
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  done        RecurringDone[]

  @@index([orgId])
}

/// One day a recurring task was done: a date of fact, typed or today. At most one per task and day.
model RecurringDone {
  id        String        @id @default(uuid()) @db.Uuid
  orgId     String        @db.Uuid
  org       Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  taskId    String        @db.Uuid
  task      RecurringTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneOn    DateTime      @db.Date
  byId      String?       @db.Uuid
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  @@unique([taskId, doneOn])
  @@index([orgId])
}
