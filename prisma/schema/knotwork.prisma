// Knotwork (clone-owned, PRD v1.1 Phase 1): the wedding, its backward-scheduled tasks, the budget and vendor book, and
// the two-key consent requests. Every table is org-owned: RLS policies in 20261123000002_rls_policies_knotwork (INV-30),
// all thirteen in the data export (src/app/export-hooks.ts, INV-34), harness rows in tests/fixtures/app.ts.
//
// RULE 1 (CLAUDE.md): the only stored deadline is Wedding.date. A task stores leadDays, bufferDays and dependencies;
// its dates are derived on read (src/lib/knotwork/schedule/engine.ts). tests/knotwork/structure.test.ts scans this
// file: a new date column fails until it is named there as a date of fact.
// RULE 2: the fields marked "designated" are written only by src/lib/knotwork/consent/execute.ts, and the database
// refuses them without an approved request (triggers in 20261123000001_knotwork_phase1).

enum TaskKind {
  template
  manual
  payment
  rsvp
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum VendorStatus {
  considering
  booked
  dropped
}

enum VendorCategory {
  venue
  caterer
  photographer
  dj
  florist
  officiant
  baker
  attire
  transport
  planner
  other
}

enum FlagReason {
  date_moved
  scope_changed
}

enum ConsentKind {
  book_vendor
  sign_contract
  spend
  change_date
  change_settings
  remove_guest
}

enum ConsentStatus {
  pending
  approved
  declined
  withdrawn
  expired
}

enum GrantScope {
  schedule_edit
  budget_view
  budget_edit
  vendors_view
  vendors_edit
  guests_edit
}

enum BaselineKind {
  initial
  move
}

/// One per org (D-07). `date` is the anchor every deadline derives from.
model Wedding {
  id                  String          @id @default(uuid()) @db.Uuid
  orgId               String          @unique @db.Uuid
  org                 Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title               String
  /// Designated after creation: changes only with an approved change_date request (dateRequestId).
  date                DateTime        @db.Date
  dateRequestId       String?         @db.Uuid
  dateRequest         ConsentRequest? @relation("weddingDate", fields: [dateRequestId], references: [id], onDelete: NoAction)
  timeZone            String          @default("America/Chicago")
  /// Designated: these three change only with an approved change_settings request (settingsRequestId).
  spendThresholdCents Int             @default(50000)
  consentExpiryDays   Int             @default(7)
  chaseBufferDays     Int             @default(14)
  settingsRequestId   String?         @db.Uuid
  settingsRequest     ConsentRequest? @relation("weddingSettings", fields: [settingsRequestId], references: [id], onDelete: NoAction)
  /// A date of fact (D-33): the first moment the workspace was seen with two partners. Never unset; while it is null
  /// and there is one partner, that partner's designated actions execute solo.
  pairedAt            DateTime?       @db.Timestamptz(6)
  createdById         String?         @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)
}

/// No date of its own: due = wedding - bufferDays (or earlier, if something depends on it); startBy = due - leadDays.
model Task {
  id          String           @id @default(uuid()) @db.Uuid
  orgId       String           @db.Uuid
  org         Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The template key, or 'rsvp-deadline' for the derived RSVP task. Null for manual and payment tasks.
  key         String?
  title       String
  kind        TaskKind         @default(manual)
  leadDays    Int
  bufferDays  Int
  status      TaskStatus       @default(todo)
  assigneeId  String?          @db.Uuid
  assignee    User?            @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// A date of fact: the day it was marked done.
  completedOn DateTime?        @db.Date
  vendorId    String?          @db.Uuid
  vendor      Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  notes       String           @default("")
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  dependsOn   TaskDependency[] @relation("dependencyTask")
  dependents  TaskDependency[] @relation("dependencyOn")
  payment     VendorPayment?

  @@unique([orgId, key])
  @@index([orgId])
}

model TaskDependency {
  id          String @id @default(uuid()) @db.Uuid
  orgId       String @db.Uuid
  org         Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  taskId      String @db.Uuid
  task        Task   @relation("dependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String @db.Uuid
  dependsOn   Task   @relation("dependencyOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([orgId])
  @@index([dependsOnId])
}

/// One row per committed wedding date: the first one, and every approved move. History, not a deadline.
model ScheduleBaseline {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @db.Uuid
  org         Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind        BaselineKind
  fromDate    DateTime?       @db.Date
  toDate      DateTime        @db.Date
  requestId   String?         @db.Uuid
  request     ConsentRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction)
  /// { tasks: { id: { title, dueFrom, dueTo, startByFrom, startByTo, state } }, late, impossible }
  snapshot    Json
  /// 16 hex characters of the preview that was committed.
  fingerprint String
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)

  @@index([orgId, createdAt])
}

model BudgetCategory {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @db.Uuid
  org           Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  estimateCents Int
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  expenses      Expense[]

  @@unique([orgId, name])
}

/// An actual. Strictly over the spend threshold it is designated: it needs an approved spend request (requestId).
model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @db.Uuid
  org         Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  categoryId  String          @db.Uuid
  category    BudgetCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendorId    String?         @db.Uuid
  vendor      Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  description String
  amountCents Int
  /// A date of fact: the day the money went out.
  paidOn      DateTime        @db.Date
  requestId   String?         @db.Uuid
  request     ConsentRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction)
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  payment     VendorPayment?

  @@index([orgId])
  @@index([categoryId])
}

/// PRD P0-7 "snapshots": the rollup frozen at a moment.
model BudgetSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  note      String   @default("")
  totals    Json
  takenById String?  @db.Uuid
  takenAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([orgId, takenAt])
}

model Vendor {
  id                 String          @id @default(uuid()) @db.Uuid
  orgId              String          @db.Uuid
  org                Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name               String
  category           VendorCategory
  contactName        String          @default("")
  email              String          @default("")
  phone              String          @default("")
  notes              String          @default("")
  /// Designated: `booked` only with an approved book_vendor request (bookedRequestId).
  status             VendorStatus    @default(considering)
  bookedRequestId    String?         @db.Uuid
  bookedRequest      ConsentRequest? @relation("vendorBooked", fields: [bookedRequestId], references: [id], onDelete: NoAction)
  contractTotalCents Int?
  /// Designated: set only with an approved sign_contract request (contractRequestId). A date of fact.
  contractSignedOn   DateTime?       @db.Date
  contractRequestId  String?         @db.Uuid
  contractRequest    ConsentRequest? @relation("vendorContract", fields: [contractRequestId], references: [id], onDelete: NoAction)
  /// Scope (D-16): a change to any of these four on a booked vendor raises a re-confirmation flag.
  deliverables       String          @default("")
  /// Minutes after midnight on the wedding day.
  arriveMin          Int?
  departMin          Int?
  countEstimate      Int?
  /// The vendor needs the final count this many days before the wedding; drives the RSVP deadline.
  countDueDaysBefore Int?
  /// Eats on site (a vendor meal in Phase 2's counts).
  onSite             Boolean         @default(false)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  tasks              Task[]
  payments           VendorPayment[]
  flags              VendorFlag[]
  briefs             VendorBrief[]
  expenses           Expense[]

  @@index([orgId])
}

/// A scheduled payment: "N days before the wedding". Its task carries it on the schedule (P0-1).
model VendorPayment {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @db.Uuid
  org           Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendorId      String    @db.Uuid
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  label         String
  amountCents   Int
  dueDaysBefore Int
  taskId        String    @unique @db.Uuid
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// A date of fact.
  paidOn        DateTime? @db.Date
  expenseId     String?   @unique @db.Uuid
  expense       Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([orgId])
  @@index([vendorId])
}

/// "Needs re-confirmation" while ackAt is null.
model VendorFlag {
  id         String     @id @default(uuid()) @db.Uuid
  orgId      String     @db.Uuid
  org        Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendorId   String     @db.Uuid
  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reason     FlagReason
  detail     Json
  raisedById String?    @db.Uuid
  raisedAt   DateTime   @default(now()) @db.Timestamptz(6)
  ackById    String?    @db.Uuid
  ackAt      DateTime?  @db.Timestamptz(6)
  ackNote    String     @default("")

  @@index([orgId, ackAt])
  @@index([vendorId])
}

/// A regenerable artifact: a new version only when the inputs changed.
model VendorBrief {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendorId      String   @db.Uuid
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  version       Int
  body          String
  inputsHash    String
  generatedById String?  @db.Uuid
  generatedAt   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([vendorId, version])
  @@index([orgId])
}

/// The two-key request (src/lib/knotwork/consent/machine.ts). `approved` is written together with the action it allows.
model ConsentRequest {
  id              String             @id @default(uuid()) @db.Uuid
  orgId           String             @db.Uuid
  org             Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind            ConsentKind
  status          ConsentStatus      @default(pending)
  payload         Json
  summary         String
  proposerId      String             @db.Uuid
  proposedAt      DateTime           @default(now()) @db.Timestamptz(6)
  /// When the request lapses: proposedAt plus the wedding's consentExpiryDays. Not a plan deadline.
  expiresAt       DateTime           @db.Timestamptz(6)
  deciderId       String?            @db.Uuid
  decidedAt       DateTime?          @db.Timestamptz(6)
  declineReason   String             @default("")
  executedAt      DateTime?          @db.Timestamptz(6)
  /// D-33: executed by the only partner of a never-paired workspace; then deciderId is null.
  solo            Boolean            @default(false)
  weddingDates    Wedding[]          @relation("weddingDate")
  weddingSettings Wedding[]          @relation("weddingSettings")
  bookedVendors   Vendor[]           @relation("vendorBooked")
  signedVendors   Vendor[]           @relation("vendorContract")
  expenses        Expense[]
  baselines       ScheduleBaseline[]
  removedGuests   Guest[]

  @@index([orgId, status])
}

/// A scoped grant for a helper (D-08). Partners need none.
model HelperGrant {
  id          String     @id @default(uuid()) @db.Uuid
  orgId       String     @db.Uuid
  org         Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       GrantScope
  grantedById String?    @db.Uuid
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)

  @@unique([orgId, userId, scope])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 2 (PRD P0-3 guest engine, P0-4 tiered backfill). RULE 3: nothing in Household.list, priority, state, invitedOn,
// waveId or createdAt may reach a guest; src/lib/knotwork/guests/projection.ts is the only guest-facing shape.

enum GuestList {
  A
  B
}

enum HouseholdState {
  queued
  invited
  regrets
}

enum AgeGroup {
  adult
  child
  infant
}

enum PartnerStatus {
  none
  dating
  long_distance
  engaged
  married
}

enum RsvpStatus {
  pending
  attending
  declined
}

enum PlusOneOverride {
  grant
  deny
}

enum ChaseKind {
  reminder
  call
}

/// One per org: the cap the invite waves run against, the venue's limits and the per-head prices.
model GuestPlan {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @unique @db.Uuid
  org             Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cap             Int      @default(100)
  venueMin        Int?
  venueMax        Int?
  perHeadCents    Int      @default(0)
  kidsMealCents   Int      @default(0)
  vendorMealCents Int      @default(0)
  /// No B wave inside this many days of the wedding; remaining B households become regrets.
  lockoutDays     Int      @default(42)
  /// A B wave releases at least this many seats, unless it is everything left.
  minBatchSeats   Int      @default(4)
  mealOptions     String[]
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
}

/// The invitation unit.
model Household {
  id                String           @id @default(uuid()) @db.Uuid
  orgId             String           @db.Uuid
  org               Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name              String
  email             String           @default("")
  phone             String           @default("")
  address1          String           @default("")
  city              String           @default("")
  region            String           @default("")
  postal            String           @default("")
  list              GuestList        @default(A)
  priority          Int              @default(100)
  state             HouseholdState   @default(queued)
  /// A date of fact: the day the invitation was released. Never shown to a guest.
  invitedOn         DateTime?        @db.Date
  waveId            String?          @db.Uuid
  wave              InviteWave?      @relation(fields: [waveId], references: [id], onDelete: SetNull)
  /// A date of fact, recorded by hand.
  saveTheDateSentOn DateTime?        @db.Date
  plusOneOverride   PlusOneOverride?
  plusOneNote       String           @default("")
  /// sha256 of the RSVP link token (INV-07), and a sealed copy so a reminder can carry the same link. Never exported.
  rsvpTokenHash     String?          @unique
  rsvpTokenSealed   String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  guests            Guest[]
  chaseEvents       ChaseEvent[]

  @@unique([orgId, name])
}

/// The response unit. Never deleted: removed only by an approved remove_guest request (rule 2).
model Guest {
  id               String          @id @default(uuid()) @db.Uuid
  orgId            String          @db.Uuid
  org              Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  householdId      String          @db.Uuid
  household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name             String
  ageGroup         AgeGroup        @default(adult)
  partnerStatus    PartnerStatus   @default(none)
  inWeddingParty   Boolean         @default(false)
  isPlusOne        Boolean         @default(false)
  rsvp             RsvpStatus      @default(pending)
  meal             String?
  dietary          String[]
  accessibility    String[]
  songRequest      String          @default("")
  /// The couple's own note. Never guest-facing, never vendor-facing.
  privateNote      String          @default("")
  respondedAt      DateTime?       @db.Timestamptz(6)
  /// Designated: set only with an approved remove_guest request (removedRequestId). A date of fact.
  removedAt        DateTime?       @db.Timestamptz(6)
  removedRequestId String?         @db.Uuid
  removedRequest   ConsentRequest? @relation(fields: [removedRequestId], references: [id], onDelete: NoAction)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)

  @@index([orgId])
  @@index([householdId])
}

/// One row per release of invitations.
model InviteWave {
  id             String      @id @default(uuid()) @db.Uuid
  orgId          String      @db.Uuid
  org            Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number         Int
  list           GuestList
  releasedAt     DateTime    @default(now()) @db.Timestamptz(6)
  releasedById   String?     @db.Uuid
  householdCount Int
  seatCount      Int
  households     Household[]

  @@unique([orgId, number])
}

/// The delta feed: "Linda declined: −$87.00".
model HeadcountDelta {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label          String
  deltaSeats     Int
  deltaCents     Int
  attendingAfter Int
  costAfterCents Int
  at             DateTime @default(now()) @db.Timestamptz(6)

  @@index([orgId, at])
}

/// A reminder sent or a personal call made, so the cadence never repeats a step.
model ChaseEvent {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  kind        ChaseKind
  step        Int
  byId        String?   @db.Uuid
  at          DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([householdId, kind, step])
  @@index([orgId])
}

/// The couple's do-not-play list; rides onto the DJ's brief.
model DoNotPlay {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title     String
  artist    String   @default("")
  addedById String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([orgId, title, artist])
}
