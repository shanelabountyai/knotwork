{
  "name": "08-refused-hits-still-count",
  "note": "Small limits. A device over its limit keeps being refused for the rest of the window (each refused try counts against the device), and its refused tries do not count against the address: after d01's three accepted uploads, five more from the same address still fit, and the next one is the address's ninth.",
  "limits": {
    "perDevice": {
      "limit": 3,
      "windowMinutes": 10
    },
    "perAddress": {
      "limit": 8,
      "windowMinutes": 10
    },
    "perEvent": {
      "limit": 12,
      "windowMinutes": 60
    }
  },
  "steps": [
    {
      "from": 0,
      "every": 1,
      "count": 7,
      "devices": [
        "d01"
      ],
      "address": "venue"
    },
    {
      "from": 10,
      "every": 1,
      "count": 6,
      "devices": [
        "d02",
        "d03"
      ],
      "address": "venue"
    }
  ],
  "expect": {
    "attempts": 13,
    "totals": {
      "address": 1,
      "device": 4,
      "ok": 8
    },
    "runs": [
      [
        "ok",
        3
      ],
      [
        "device",
        4
      ],
      [
        "ok",
        5
      ],
      [
        "address",
        1
      ]
    ]
  }
}
