    {
      "file": "phone-gps.jpg",
      "note": "What a phone leaves: EXIF with a GPS position, XMP, an ICC profile and a comment. Stored with none of them.",
      "expect": {
        "type": "jpeg",
        "width": 640,
        "height": 480,
        "before": [
          "comment",
          "exif",
          "gps",
          "icc",
          "xmp"
        ],
        "result": "ok",
        "stored": {
          "full": {
            "type": "jpeg",
            "width": 640,
            "height": 480
          },
          "display": {
            "type": "jpeg",
            "width": 640,
            "height": 480
          },
          "thumb": {
            "type": "jpeg",
            "width": 400,
            "height": 300
          }
        },
        "after": []
      }
    },
